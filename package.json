{
  "name": "vscode-gherkin-powertools",
  "displayName": "Gherkin PowerTools - BDD & Python Behave Toolkit",
  "description": "Gherkin formatting, linting, project analysis, Python/Behave navigation, and execution/debugging for BDD.",
  "version": "1.7.8",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Testing",
    "Formatters",
    "Linters"
  ],
  "keywords": [
    "gherkin",
    "cucumber",
    "bdd",
    "behave",
    "python"
  ],
  "publisher": "carloscamara",
  "author": "Carlos Camara",
  "icon": "assets/logo-transparent.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/carlos-camara/vscode-gherkin-powertools"
  },
  "bugs": {
    "url": "https://github.com/carlos-camara/vscode-gherkin-powertools/issues"
  },
  "homepage": "https://github.com/carlos-camara/vscode-gherkin-powertools#readme",
  "activationEvents": [
    "onLanguage:feature"
  ],
  "main": "./dist/extension.js",
  "configurationDefaults": {
    "testing.showCoverageInExplorer": false
  },
  "contributes": {
    "languages": [
      {
        "id": "feature",
        "extensions": [
          ".feature"
        ],
        "aliases": [
          "Feature",
          "gherkin"
        ]
      }
    ],
    "configuration": {
      "title": "Gherkin PowerTools",
      "properties": {
        "gherkinPowerTools.profile": {
          "type": "string",
          "enum": [
            "custom",
            "strict",
            "team",
            "minimal",
            "legacy"
          ],
          "default": "custom",
          "markdownDescription": "Select a configuration profile. Individual settings override the profile defaults.",
          "markdownEnumDescriptions": [
            "Custom configuration (default)",
            "Strict formatting rules",
            "Team shared configuration",
            "Minimal formatting rules",
            "Legacy formatting rules"
          ]
        },
        "gherkinPowerTools.indentation.steps": {
          "type": "number",
          "default": 4,
          "markdownDescription": "Number of spaces to indent steps."
        },
        "gherkinPowerTools.tables.alignToKeyword": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "If true, tables align dynamically to the start of the step text. If false, tables simply indent slightly more than the step keyword."
        },
        "gherkinPowerTools.tags.format": {
          "type": "string",
          "enum": [
            "wrap",
            "singleLine"
          ],
          "default": "wrap",
          "markdownDescription": "How to format long lists of tags. 'wrap' splits them across multiple lines (max 80 chars), 'singleLine' keeps them all on one line.",
          "markdownEnumDescriptions": [
            "Splits tags across multiple lines (max 80 chars)",
            "Keeps all tags on one line"
          ]
        },
        "gherkinPowerTools.tags.sort": {
          "type": "string",
          "enum": [
            "preserve",
            "alphabetical"
          ],
          "default": "preserve",
          "markdownDescription": "How to sort tags. 'preserve' keeps their original source order, 'alphabetical' sorts them A-Z.",
          "markdownEnumDescriptions": [
            "Keeps their original source order",
            "Sorts them A-Z"
          ]
        },
        "gherkinPowerTools.emptyLines.betweenScenarios": {
          "type": "number",
          "default": 1,
          "markdownDescription": "Number of empty lines to enforce between Scenario/Rule/Background blocks."
        },
        "gherkinPowerTools.behave.stepGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/steps/**/*.py",
            "**/features/steps/**/*.py"
          ],
          "markdownDescription": "Glob patterns to locate Python/Behave step definition files."
        },
        "gherkinPowerTools.behave.ignoreGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.venv/**",
            "**/venv/**",
            "**/env/**"
          ],
          "markdownDescription": "Glob patterns to ignore when locating Python/Behave step definition files."
        },
        "gherkinPowerTools.behave.additionalArguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "Additional arguments to pass to Behave when executing via the Test Explorer."
        },
        "gherkinPowerTools.behave.command": {
          "type": "string",
          "default": "behave",
          "scope": "resource",
          "markdownDescription": "The base command to run Behave."
        }
      }
    },
    "commands": [
      {
        "command": "gherkinPowerTools.commandCenter",
        "title": "Gherkin PowerTools: Command Center",
        "category": "Gherkin PowerTools"
      },
      {
        "command": "gherkinPowerTools.format",
        "title": "Format Gherkin Document",
        "category": "Gherkin PowerTools"
      },
      {
        "command": "gherkinPowerTools.showStatistics",
        "title": "Show Project Statistics",
        "category": "Gherkin PowerTools"
      },
      {
        "command": "gherkinPowerTools.runFeature",
        "title": "Run Feature",
        "category": "Gherkin PowerTools"
      },
      {
        "command": "gherkinPowerTools.runScenario",
        "title": "Run Scenario",
        "category": "Gherkin PowerTools"
      },
      {
        "command": "gherkinPowerTools.runFeatureWithArgs",
        "title": "Edit Feature...",
        "category": "Gherkin PowerTools"
      },
      {
        "command": "gherkinPowerTools.runScenarioWithArgs",
        "title": "Edit Scenario...",
        "category": "Gherkin PowerTools"
      },
      {
        "command": "gherkinPowerTools.debugFeature",
        "title": "Debug Feature",
        "category": "Gherkin PowerTools"
      },
      {
        "command": "gherkinPowerTools.debugScenario",
        "title": "Debug Scenario",
        "category": "Gherkin PowerTools"
      },
      {
        "command": "gherkinPowerTools.diagnoseWorkspace",
        "title": "Diagnose Workspace",
        "category": "Gherkin PowerTools"
      },
      {
        "command": "gherkinPowerTools.testExplorerEditAndRun",
        "title": "Edit Behave args & Run",
        "category": "Gherkin PowerTools",
        "icon": "$(edit)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorLangId == feature",
          "command": "gherkinPowerTools.showStatistics",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "gherkinPowerTools.testExplorerEditAndRun",
          "when": "view == workbench.view.testing",
          "group": "navigation"
        }
      ]
    },
    "snippets": [
      {
        "language": "feature",
        "path": "./snippets.json"
      }
    ],
    "walkthroughs": [
      {
        "id": "gherkinPowerTools.walkthrough",
        "title": "Get Started with Gherkin PowerTools",
        "description": "Learn how to format, lint, and navigate your BDD features.",
        "steps": [
          {
            "id": "openFeature",
            "title": "Open or create a feature file",
            "description": "Open a `.feature` file to activate Gherkin PowerTools.",
            "media": {
              "markdown": "assets/walkthrough/1_open.md"
            }
          },
          {
            "id": "formatDocument",
            "title": "Format your Gherkin",
            "description": "Format your features to align tables and standardize indentation. [Format Document](command:editor.action.formatDocument)",
            "media": {
              "markdown": "assets/walkthrough/2_format.md"
            },
            "completionEvents": [
              "onCommand:editor.action.formatDocument"
            ]
          },
          {
            "id": "formatOnSave",
            "title": "Enable Format on Save",
            "description": "Save time by enabling VS Code's Format on Save setting for Gherkin files. [Open Settings](command:workbench.action.openSettings?%22%5Bfeature%5D%20editor.formatOnSave%22)",
            "media": {
              "markdown": "assets/walkthrough/3_formatOnSave.md"
            },
            "completionEvents": [
              "onSettingChanged:editor.formatOnSave"
            ]
          },
          {
            "id": "configureGlobs",
            "title": "Configure Behave Step Discovery",
            "description": "If your Python steps are not in the default `features/steps` folder, update the Step Globs setting. [Configure Step Globs](command:workbench.action.openSettings?%22gherkinPowerTools.behave.stepGlobs%22)",
            "media": {
              "markdown": "assets/walkthrough/4_discovery.md"
            },
            "completionEvents": [
              "onSettingChanged:gherkinPowerTools.behave.stepGlobs"
            ]
          },
          {
            "id": "goToDefinition",
            "title": "Navigate to Python Steps",
            "description": "Right-click a step and select **Go to Definition** (F12) to jump straight to the Python implementation. [Go to Definition](command:editor.action.revealDefinition)",
            "media": {
              "markdown": "assets/walkthrough/5_navigation.md"
            },
            "completionEvents": [
              "onCommand:editor.action.revealDefinition"
            ]
          },
          {
            "id": "projectStatistics",
            "title": "View BDD Statistics",
            "description": "Generate an interactive HTML dashboard with your BDD project metrics. [Show Statistics](command:gherkinPowerTools.showStatistics)",
            "media": {
              "markdown": "assets/walkthrough/6_statistics.md"
            },
            "completionEvents": [
              "onCommand:gherkinPowerTools.showStatistics"
            ]
          },
          {
            "id": "execution",
            "title": "Execute Behave Tests",
            "description": "Run and Edit your features directly from the Test Explorer. [Run Feature](command:gherkinPowerTools.runFeature)",
            "media": {
              "markdown": "assets/walkthrough/8_execution.md"
            },
            "completionEvents": [
              "onCommand:gherkinPowerTools.runFeature"
            ]
          },
          {
            "id": "codeActions",
            "title": "Intelligent Quick Fixes",
            "description": "Press `Cmd + .` or `Ctrl + .` to generate missing steps, insert colons, or fix block structure. [Quick Fix](command:editor.action.quickFix)",
            "media": {
              "markdown": "assets/walkthrough/9_codeactions.md"
            },
            "completionEvents": [
              "onCommand:editor.action.quickFix"
            ]
          },
          {
            "id": "commandCenter",
            "title": "Gherkin Command Center",
            "description": "Discover all extension capabilities from a single interactive menu. [Open Command Center](command:gherkinPowerTools.commandCenter)",
            "media": {
              "markdown": "assets/walkthrough/10_command_center.md"
            },
            "completionEvents": [
              "onCommand:gherkinPowerTools.commandCenter"
            ]
          },
          {
            "id": "documentation",
            "title": "Find Documentation & Support",
            "description": "Read the full documentation or ask questions on our GitHub Discussions. [Open Repository](https://github.com/carlos-camara/vscode-gherkin-powertools)",
            "media": {
              "markdown": "assets/walkthrough/7_support.md"
            },
            "completionEvents": [
              "onLink:https://github.com/carlos-camara/vscode-gherkin-powertools"
            ]
          }
        ]
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": ".gherkin-powertoolsrc.json",
        "url": "./gherkin-powertools.schema.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run esbuild -- --production",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "esbuild": "node esbuild.js",
    "esbuild-watch": "node esbuild.js --watch",
    "pretest": "npm run compile && npm run esbuild",
    "test": "vscode-test --label unitTests",
    "test:e2e": "vscode-test --label e2eTests",
    "check:config": "node scripts/check-config-sync.js",
    "coverage": "vscode-test --label unitTests --coverage --coverage-reporter=lcov --coverage-reporter=text --coverage-reporter=html --coverage-reporter=json-summary"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.93.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "c8": "^12.0.0",
    "esbuild": "^0.28.1",
    "mocha": "^11.7.6",
    "mocha-junit-reporter": "^2.2.1",
    "mocha-multi-reporters": "^1.5.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "brace-expansion": "^2.1.2",
    "js-yaml": "^4.3.0"
  },
  "dependencies": {
    "@cucumber/gherkin": "^42.0.0",
    "@cucumber/messages": "^34.2.0"
  }
}
